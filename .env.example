# PORT is pinned in docker-compose.yml's `environment:`, which wins over
# `env_file:`, so a value here is inert in production and governs local runs
# alone. HOST is deliberately not pinned there, so a value here DOES take
# effect: 0.0.0.0 is the container's own namespace, and the host-side
# restriction lives on the published port instead. Setting 127.0.0.1 binds a
# loopback the port mapping cannot reach, and every proxied request 502s.
PORT=5880
HOST=0.0.0.0

# adapter-node compares the browser's Origin header against this. Name a host
# the browser is not on and every form action fails with "Cross-site POST form
# submissions are forbidden" while page loads keep working.
ORIGIN=https://www.example.org

# Apex domain of this deployment. Session cookies are scoped to
# `.<PUBLIC_BASE_DOMAIN>` (so every subdomain shares sign-in), and the
# host-derived branding (canonical www URL, email sender name, hello@
# addresses) flows from it too. Takes the apex, never the www host.
PUBLIC_BASE_DOMAIN=example.org

# Session cookie name. Optional; unset means `community_session`. The cookie is
# scoped to the apex (`.PUBLIC_BASE_DOMAIN`), so every deployment under one apex
# that shares a name is sent the other's cookie, and signing in on one signs you
# out of the other. A second deployment beside production (a preview on
# new.example.org while www keeps serving) sets its own name here.
#
# Changing it on a running deployment signs every member out once, as moving
# the apex does. A bad value refuses to start rather than looping sign-in: it
# must be a plain cookie token (letters, digits, no spaces), must not begin
# `__Host-`, and must not reuse the site gate's cookie or the two retired
# marketing cookies. A present-but-blank line counts as bad, so leave this
# commented out to take the default.
# SESSION_COOKIE_NAME=community_session

# Logging — `info` is the default; flip to `debug` for verbose tracing of
# the auth paths in docker logs. Lines are JSON; pipe to `jq`.
# LOG_LEVEL=info

# Development gate — a shared password in front of the whole site, for the
# period where this deployment is being worked on and should not be publicly
# browsable. `off` (or unset) is a straight passthrough that costs nothing;
# `password` puts every rendered page, form action and endpoint behind the
# form. Anything else refuses to start, so a typo cannot come up open. It is
# not authentication: it proves somebody was told a password, and every
# sign-in, membership and admin check behind it still applies.
# SITE_GATE=off

# Required when SITE_GATE=password; the process refuses to start without it.
# Also the revocation mechanism — the gate cookie is keyed on this value, so
# changing it puts every tester back at the door on their next request.
# SITE_GATE_PASSWORD=

# How long one successful entry lasts, in seconds. Default 2592000 (30 days).
# The expiry is signed into the cookie, so it cannot be extended by hand.
# SITE_GATE_MAX_AGE=2592000

# Redis holds sessions and single-use magic-link tokens. REDIS_URL selects the
# RESP client and takes precedence over the Upstash pair below, so a leftover
# UPSTASH_* value cannot quietly capture sessions. Production pins this in
# docker-compose.yml (redis://redis:6379); the Upstash keys have no place in
# that deployment's secrets file, because sessions and sign-in tokens would
# then cross a WAN to a third party. The value below is the local one, matching
# docker-compose.dev.yml.
REDIS_URL=redis://127.0.0.1:5882

# Key prefix, so two deployments sharing one Redis cannot read each other's
# sessions. Distinct per deployment.
LOREM_REDIS_PREFIX=lorem-prod

# The REST client, read only when REDIS_URL is unset. Kept for a deployment
# with no Redis of its own; the deployment of record has one.
# UPSTASH_REDIS_REST_URL=https://<your>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# Postgres: the member directory. A dedicated `lorem` database keeps it apart
# from anything else the server holds. Defaults below match
# src/lib/server/postgres-config.ts.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DATABASE=lorem
POSTGRES_USER=lorem
POSTGRES_PASSWORD=

# TLS to Postgres. As shipped (`false`) the connection is plaintext, which is
# correct only while Postgres listens on this host's loopback — the deployment
# of record. Point POSTGRES_HOST at anything across a network and this becomes
# `true`, or the member directory crosses that network in clear.
#
# `true` verifies the server certificate against the system trust store. No
# value of this key encrypts without authenticating.
POSTGRES_SSL=false

# CA that signed the Postgres server certificate, for a managed provider whose
# root is not in the system trust store. Either a path (mount it into the
# container) or the PEM itself with literal `\n` between lines. Left unset,
# POSTGRES_SSL=true trusts the system store alone and a private-CA provider
# fails the handshake — supply this rather than reaching for the next key.
# POSTGRES_SSL_CA=/etc/ssl/certs/provider-ca.pem

# Escape hatch. `true` keeps TLS on and stops checking who is on the other end,
# so anyone able to intercept the connection reads the whole directory. Left
# unset — the shipped state — certificates are verified. This is for diagnosing
# a handshake failure over a few minutes, never for running: it logs
# `postgres.ssl-insecure` at warn on every start, and that line is the defect.
# POSTGRES_SSL_INSECURE=false

# Mail — REQUIRED. Every message the app sends (sign-in links, membership-request
# notices, approval mails) goes out over one transport,
# selected here. Unset behaves as `smtp`.
#
#   MAIL_TRANSPORT   — `smtp` or `mailgun`. Any other value refuses to start,
#                      naming the variable, rather than picking one.
#   SMTP_HOST/PORT   — the submission host. 587 (STARTTLS) is the default; 465
#                      selects implicit TLS. Port 25 is refused: it is relay, not
#                      submission. The certificate is always verified — no key
#                      here turns that off.
#   SMTP_USER/PASSWORD — the mailbox's submission credentials.
#                      Missing either means nothing sends: `pnpm dev` prints the
#                      sign-in link to the console instead (README.md, Quick start),
#                      and production 500s the /login submit.
#   MAIL_FROM        — envelope and From: address. Defaults to
#                      no-reply@<PUBLIC_BASE_DOMAIN>, which is the domain the
#                      SMTP host should hold the DKIM key for. A value on any other domain sends
#                      unsigned mail, which is how sign-in links land in spam.
MAIL_TRANSPORT=smtp
SMTP_HOST=mail.example.org
# SMTP_PORT=587
SMTP_USER=no-reply@example.org
SMTP_PASSWORD=
# MAIL_FROM=no-reply@example.org

# The alternative transport, and the reason mailgun.js and form-data are still
# dependencies. Both keys are required once MAIL_TRANSPORT=mailgun.
#   MAILGUN_PRIVATE  — Mailgun private API key.
#   MAIL_DOMAIN      — the Mailgun domain this deployment sends from. No default:
#                      with it unset the app refuses to start and names it,
#                      because a fallback would send from a domain it does not own.
MAILGUN_PRIVATE=
# MAIL_DOMAIN=mg.example.org

# Where new membership-request notifications are emailed (the admins who review
# them, with a link to the approval page). Comma-separated for multiple admins;
# unset = no notification is sent.
NOTIFY_ADMIN_ADDRESS=

# Comma-separated subjects with superadmin access (email:<addr> form). The
# superadmin bootstraps per-group admins (group_admin table) via the admin UI.
# Empty = no superadmin (default).
# Example: ADMIN_SUBJECTS=email:admin@example.org
ADMIN_SUBJECTS=

