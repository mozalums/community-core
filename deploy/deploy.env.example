# Where this deployment sits. Copy to deploy/deploy.env on the host and edit;
# that file is gitignored, because it describes a machine rather than the site.
#
# Every value below is the default already compiled into docker-compose.yml and
# deploy/*.sh, so a host that takes the defaults needs no file at all.
# The point of the file is a second stack beside the first, or a move.
#
# These are host facts, not credentials. The secrets themselves live in the three
# files under LOREM_SECRETS_DIR and never in here.

# The directory holding .env (app), postgres.env (database) and backup.env.
# Read by docker-compose.yml's four env_file keys, deploy.sh's config check and
# backup.sh, so all three move together.
#LOREM_SECRETS_DIR=/data/secrets/lorem-host

# What the app container publishes on. Loopback because a reverse proxy is the
# only intended way in: publishing to 0.0.0.0 puts Node on the public interface,
# past every header and TLS setting the proxy applies. deploy.sh probes whatever
# is set here, so the two cannot drift.
#LOREM_BIND_ADDR=127.0.0.1
#LOREM_HOST_PORT=5880

# Seconds deploy.sh waits for /healthz before it gives up and prints the logs.
#LOREM_HEALTH_TIMEOUT=120

# Names the compose project and all three containers. Container names are global
# on a daemon, so this is what lets a second stack run beside production.
#COMPOSE_PROJECT_NAME=lorem-host

# Staging directory for a dump between pg_dump writing it and rclone confirming
# it on the remote. Root-owned 0700; backup.sh creates it.
#LOREM_BACKUP_DIR=/var/backups/lorem-host

# The flock backup.sh takes so two runs cannot overlap.
#LOREM_BACKUP_LOCK=/var/lock/lorem-host-backup.lock
